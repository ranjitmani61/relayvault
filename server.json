{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ranjitmani61/relayvault",
  "title": "RelayVault",
  "description": "Local MCP server for encrypted task checkpoints and reversible pattern redaction",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/ranjitmani61/relayvault",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "relayvault",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
